    <string name="a11y_disclosure_title">Accessibility access</string>
    <string name="a11y_disclosure_body">Ctrus uses Android\'s Accessibility service to know which app is in the foreground, so it can show the block screen when you open something a profile is blocking. It only reads the name of the app currently on screen — it does not read passwords, messages, or anything you type, and nothing leaves your device.</string>
    <string name="a11y_disclosure_agree_checkbox">I understand and agree</string>
    <string name="a11y_disclosure_continue">Continue to Settings</string>
    <string name="battery_optimization_title">Keep blocking running reliably</string>
    <string name="battery_optimization_body">Some phone brands aggressively stop apps running in the background to save battery, which can silently turn off blocking mid-session. This only affects Ctrus — your other apps\' battery settings won\'t change.</string>
