<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground-app detection (Usage Access, granted manually in Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed to list installed apps when building a blocking profile -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Scheduled starts, reminders, Duration auto-stops and break ends must fire on time even in
         Doze ("Alarms & reminders"). Deliberately NOT USE_EXACT_ALARM: Google Play reserves that
         for alarm-clock/calendar apps. See ExactAlarmPermissionUtil. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- AlarmManager alarms don't survive a reboot — ScheduleReceiver re-arms scheduled starts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the accessibility service survive Doze/App Standby on OEM skins (MIUI, ColorOS,
         FuntouchOS/OriginOS, OxygenOS) that kill background services more aggressively than
         stock Android — see BatteryOptimizationUtil. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Recovery-code verification against recover.ctrus.pt -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CtrusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ctrus"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Ctrus"
            android:configChanges="screenLayout|smallestScreenSize|screenSize|orientation|uiMode|density">
            <!-- Mirrors the iOS ctrus.pt/profile/<id> deep link used by NFC tags & the widget -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ctrus.pt" />
            </intent-filter>
        </activity>

        <!--
          Android equivalent of iOS's AppIconPicker.swift (UIApplication.setAlternateIconName):
          Android has no direct API to swap the launcher icon, so mo.dev.ctrus.icon.AppIconController
          instead enables exactly one of these aliases (all pointing at .MainActivity) and disables
          the rest via PackageManager.setComponentEnabledSetting. Exactly one must start enabled —
          Orange, matching ThemeColorOption's default and the current @mipmap/ic_launcher art.
          Icon art is the adaptive mipmap/ic_launcher_<color>[_round] set generated via Image Asset
          Studio (also reused for the in-app picker preview).
        -->
        <activity-alias
            android:name=".OrangeIconAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_orange_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LimeIconAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_lime"
            android:roundIcon="@mipmap/ic_launcher_lime_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LemonIconAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_lemon"
            android:roundIcon="@mipmap/ic_launcher_lemon_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DarkIconAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".blocking.BlockerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:theme="@style/Theme.Ctrus" />

        <!-- Fired by AlarmSchedulingGateway to auto-end/resume sessions, breaks, pauses, and grants -->
        <receiver
            android:name=".scheduling.ExpiryReceiver"
            android:exported="false" />

        <!-- "Schedule + Ctrus NFC": automatic starts, 5-minute reminders, and re-arming them all
             after a reboot / app update / clock change -->
        <receiver
            android:name=".scheduling.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- "Alarms & reminders" just got granted: re-arm everything as exact alarms -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Primary blocking mechanism (see AGENTS.md for the Switchly-derived rationale) -->
        <service
            android:name=".blocking.BlockingAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
